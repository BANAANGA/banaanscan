(drivers/net/wireless/ath/ath9k: hif_usb.c, htc_hst.c, wmi.c, htc_drv_init.c, htc_drv_main.c, htc_drv_txrx.c, hw.c,
ar5008_phy.c, ar9002_hw.c, ar9002_phy.c, ar9002_calib.c, calib.c, ani.c, eeprom_4k.c, and the register headers; the
